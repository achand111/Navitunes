<Window x:Class="Navitunes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Navitunes"
        Width="1020" Height="700"
        MinWidth="880" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource BgBrush}"
        FontFamily="{StaticResource AppFont}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="46"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="ChromeBox" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderSoftBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
        </Style>
    </Window.Resources>

    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
                <RowDefinition Height="34" />
            </Grid.RowDefinitions>

            <!-- ================= titlebar ================= -->
            <Grid Grid.Row="0" Background="{StaticResource PanelBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="54" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9"
                        Background="{StaticResource AccentBrush}" Margin="12,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="N" Foreground="White" FontWeight="Bold"
                               FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Navitunes" FontSize="15" FontWeight="SemiBold" />
                    <Border Background="{StaticResource CardBrush}" CornerRadius="6"
                            Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v2.0" FontSize="10.5" Foreground="{StaticResource MutedBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleButton}" Click="Minimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Button>
                    <Button Style="{StaticResource TitleButton}" Click="Maximize_Click">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Button>
                    <Button Style="{StaticResource TitleButton}" Click="Close_Click" Background="Transparent">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= body ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- left: connection -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                              Padding="14" Background="{StaticResource BgBrush}">
                    <StackPanel>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Navidrome" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock Text="Connect once, load everything." Margin="0,2,0,14"
                                           Style="{StaticResource MutedText}" FontSize="11.5" />

                                <TextBlock Text="URL" Style="{StaticResource FaintText}" FontSize="10.5" Margin="2,0,0,3" />
                                <TextBox x:Name="UrlBox" Text="http://" Margin="0,0,0,10" />

                                <TextBlock Text="Username" Style="{StaticResource FaintText}" FontSize="10.5" Margin="2,0,0,3" />
                                <TextBox x:Name="UserBox" Margin="0,0,0,10" />

                                <TextBlock Text="Password" Style="{StaticResource FaintText}" FontSize="10.5" Margin="2,0,0,3" />
                                <PasswordBox x:Name="PassBox" Margin="0,0,0,14" />

                                <TextBlock Text="iTunes Library.xml" Style="{StaticResource FaintText}" FontSize="10.5" Margin="2,0,0,3" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="XmlBox" Grid.Column="0" Padding="10,7,10,7"
                                             VerticalContentAlignment="Center" />
                                    <Button Grid.Column="1" x:Name="BrowseBtn" Content="Browse"
                                            Style="{StaticResource GhostButton}"
                                            Margin="8,0,0,0" Click="BrowseXml_Click" />
                                </Grid>

                                <Button x:Name="ConnectBtn" Content="Connect" Style="{StaticResource PrimaryButton}"
                                        Margin="0,16,0,0" Height="36" Click="Connect_Click" />
                                <ProgressBar x:Name="ConnectProgress" Margin="0,10,0,0"
                                             Maximum="1" Height="4" IsEnabled="False" />
                                <TextBlock x:Name="ConnectStatus" Margin="0,8,0,0"
                                           Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="16" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock Text="Library" FontSize="16" FontWeight="SemiBold" />
                                <TextBlock x:Name="LibrarySummary" Margin="0,6,0,0"
                                           Style="{StaticResource MutedText}" FontSize="12"
                                           Text="Connect to see what's here." TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- right: import cards + log -->
                <Grid Grid.Column="1" Margin="0,0,14,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- import cards -->
                    <UniformGrid Grid.Row="0" Columns="3" Margin="0,14,0,8">
                        <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="&#xE8ED;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Playlists" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,2" />
                                <TextBlock Text="Recreate your iTunes playlists in order."
                                           Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" />
                                <TextBlock x:Name="PlaylistSummary" Margin="0,10,0,0"
                                           Style="{StaticResource FaintText}" FontSize="11" TextWrapping="Wrap"
                                           Text="Connect to enable." />
                                <ProgressBar x:Name="PlaylistProgress" Margin="0,10,0,0" Maximum="1" Height="4" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="PlaylistPreviewBtn" Content="Preview" Style="{StaticResource GhostButton}"
                                            Click="PlaylistPreview_Click" />
                                    <Button x:Name="PlaylistImportBtn" Content="Import" Style="{StaticResource PrimaryButton}"
                                            Margin="8,0,0,0" Click="PlaylistImport_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="3,0,3,0">
                            <StackPanel>
                                <TextBlock Text="&#xE734;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Loved" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,2" />
                                <TextBlock Text="Star your loved &hearts; tracks as Favorites."
                                           Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" />
                                <TextBlock x:Name="LovedSummary" Margin="0,10,0,0"
                                           Style="{StaticResource FaintText}" FontSize="11" TextWrapping="Wrap"
                                           Text="Connect to enable." />
                                <ProgressBar x:Name="LovedProgress" Margin="0,10,0,0" Maximum="1" Height="4" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="LovedPreviewBtn" Content="Preview" Style="{StaticResource GhostButton}"
                                            Click="LovedPreview_Click" />
                                    <Button x:Name="LovedImportBtn" Content="Import" Style="{StaticResource PrimaryButton}"
                                            Margin="8,0,0,0" Click="LovedImport_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="14" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="&#xE7E8;" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="Ratings" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,2" />
                                <TextBlock Text="Apply your 1&#8211;5 star ratings."
                                           Style="{StaticResource MutedText}" FontSize="11.5" TextWrapping="Wrap" />
                                <TextBlock x:Name="RatingsSummary" Margin="0,10,0,0"
                                           Style="{StaticResource FaintText}" FontSize="11" TextWrapping="Wrap"
                                           Text="Connect to enable." />
                                <ProgressBar x:Name="RatingsProgress" Margin="0,10,0,0" Maximum="1" Height="4" />
                                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                    <Button x:Name="RatingsPreviewBtn" Content="Preview" Style="{StaticResource GhostButton}"
                                            Click="RatingsPreview_Click" />
                                    <Button x:Name="RatingsImportBtn" Content="Import" Style="{StaticResource PrimaryButton}"
                                            Margin="8,0,0,0" Click="RatingsImport_Click" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- log -->
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="2,4,2,6">
                            <TextBlock Text="Log" FontSize="13" FontWeight="SemiBold" DockPanel.Dock="Left" />
                            <Button x:Name="RunAllBtn" Content="Preview all" DockPanel.Dock="Right"
                                    Style="{StaticResource GhostButton}" Padding="10,4" FontSize="11"
                                    Click="RunAll_Click" />
                        </DockPanel>
                        <TextBox x:Name="LogBox" Grid.Row="1" Style="{StaticResource LogBox}" />
                    </Grid>
                </Grid>
            </Grid>

            <!-- ================= status bar ================= -->
            <Grid Grid.Row="2" Background="{StaticResource PanelBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0">
                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,8,0"
                             VerticalAlignment="Center" Fill="{StaticResource FaintBrush}" />
                    <TextBlock x:Name="StatusText" Text="Not connected" VerticalAlignment="Center"
                               Style="{StaticResource MutedText}" FontSize="11.5" />
                </StackPanel>
                <TextBlock x:Name="StatsText" Grid.Column="1" TextAlignment="Right" Margin="14,0"
                           VerticalAlignment="Center" Style="{StaticResource FaintText}" FontSize="11" />
            </Grid>
        </Grid>
    </Border>
</Window>