<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- window / surfaces -->
    <Color x:Key="BgColor">#101318</Color>
    <Color x:Key="PanelColor">#161B22</Color>
    <Color x:Key="CardColor">#1C232B</Color>
    <Color x:Key="CardHoverColor">#212A34</Color>
    <Color x:Key="InputColor">#0E1217</Color>
    <Color x:Key="BorderColor">#2E3844</Color>
    <Color x:Key="BorderSoftColor">#24303D</Color>

    <!-- text -->
    <Color x:Key="TextColor">#E6EDF3</Color>
    <Color x:Key="MutedColor">#8B949E</Color>
    <Color x:Key="FaintColor">#5C6670</Color>

    <!-- accent -->
    <Color x:Key="AccentColor">#4C8DEC</Color>
    <Color x:Key="AccentHoverColor">#6BA1F5</Color>
    <Color x:Key="AccentPressedColor">#3B79D6</Color>

    <!-- status -->
    <Color x:Key="GoodColor">#3FB950</Color>
    <Color x:Key="WarnColor">#D29922</Color>
    <Color x:Key="BadColor">#F85149</Color>

    <!-- solid brushes -->
    <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="{StaticResource CardHoverColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="{StaticResource BorderSoftColor}" />

    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />

    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />

    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, monospace</FontFamily>

</ResourceDictionary>